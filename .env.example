# Copy to .env for local runs. .env is gitignored.
# In GitHub Actions these come from repository secrets instead.

# Trade Me developer app (https://developer.trademe.co.nz/api-overview/registering-an-application)
# All four are required: search is a protected endpoint.
TRADEME_CONSUMER_KEY=
TRADEME_CONSUMER_SECRET=
TRADEME_TOKEN=
TRADEME_TOKEN_SECRET=

# LLM judge (DeepSeek, OpenAI-compatible)
DEEPSEEK_API_KEY=

# ntfy topic name only, not the full URL
NTFY_TOPIC=dealsteal-nz
